# Development only. Use a secret manager in deployed environments.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-unique-secret-before-production
# Pooled Neon URL for the running API. Use DATABASE_URL_UNPOOLED only for migrations.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
# Generate once with a cryptographically secure random 32-byte value, then base64url encode it.
MFA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
# SHA-256/base64url hash of a one-time bootstrap token. Delete it after the
# first platform superuser completes mandatory MFA enrollment.
SUPERUSER_BOOTSTRAP_TOKEN_HASH=
